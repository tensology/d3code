SUBROUTINE D3CODE.CANCEL(ORDERNO, RESP)
* Reverse an unpaid order: restore stock for every line, credit the customer
* balance, mark the order CANCELLED. Paid orders must be credited instead.
  RESP = ""
  OPEN "D3CODE.ORDERS" TO OF ELSE RESP = "FILE.ORDERS"; RETURN
  OPEN "D3CODE.CUSTOMERS" TO CF ELSE RESP = "FILE.CUSTOMERS"; RETURN
  OPEN "D3CODE.LINES" TO LF ELSE RESP = "FILE.LINES"; RETURN
  OPEN "D3CODE.PRODUCTS" TO PF ELSE RESP = "FILE.PRODUCTS"; RETURN
  READU OREC FROM OF, ORDERNO ELSE RESP = "UNKNOWN.ORDER:" : ORDERNO; RETURN
  STATUS = OREC<3>
  IF STATUS = "CANCELLED" THEN
    RESP = "ALREADY.CANCELLED"
    RELEASE OF, ORDERNO
    RETURN
  END
  IF STATUS = "PAID" THEN
    RESP = "PAID.CANNOT.CANCEL"
    RELEASE OF, ORDERNO
    RETURN
  END
  CUST = OREC<2>
  LINES = OREC<7>
  TOTAL = OREC<4>
  OREC<3> = "CANCELLED"
  WRITE OREC ON OF, ORDERNO
  RELEASE OF, ORDERNO
  MISSINGCOUNT = 0
  FOR I = 1 TO LINES
    LID = ORDERNO : "*" : I
    READ LREC FROM LF, LID ELSE LREC = ""
    SKU = LREC<2>
    IF SKU <> "" THEN
      READU PREC FROM PF, SKU ELSE PREC = ""
      IF PREC = "" THEN
        MISSINGCOUNT = MISSINGCOUNT + 1
        PRINT "CANCEL.WARNING: product removed, stock not restored: " : SKU
      END ELSE
        PREC<3> = PREC<3> + LREC<3>
        WRITE PREC ON PF, SKU
        RELEASE PF, SKU
      END
    END
  NEXT I
  READU CREC FROM CF, CUST ELSE CREC = ""
  IF CREC <> "" THEN
    CREC<4> = CREC<4> - TOTAL
    WRITE CREC ON CF, CUST
    RELEASE CF, CUST
  END
  IF MISSINGCOUNT > 0 THEN
    RESP = "OK.PARTIAL"
  END ELSE
    RESP = "OK"
  END
  RETURN
