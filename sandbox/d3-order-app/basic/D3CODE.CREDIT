SUBROUTINE D3CODE.CREDIT(ORDERNO, SKU, QTY, RESP)
* Return goods against an order: put stock back, reduce the order's subtotal, VAT
* and total, reduce the customer balance, and journal a CREDIT movement.
  RESP = ""
  OPEN "D3CODE.ORDERS" TO OF ELSE RESP = "FILE.ORDERS"; RETURN
  OPEN "D3CODE.CUSTOMERS" TO CF ELSE RESP = "FILE.CUSTOMERS"; RETURN
  OPEN "D3CODE.PRODUCTS" TO PF ELSE RESP = "FILE.PRODUCTS"; RETURN
  OPEN "D3CODE.MOVES" TO MF ELSE RESP = "FILE.MOVES"; RETURN
  IF QTY < 1 THEN RESP = "BAD.QTY"; RETURN
  READU OREC FROM OF, ORDERNO ELSE RESP = "UNKNOWN.ORDER:" : ORDERNO; RETURN
  IF OREC<3> = "CANCELLED" THEN
    RESP = "CANCELLED.ORDER"
    RELEASE OF, ORDERNO
    RETURN
  END
  READU PREC FROM PF, SKU ELSE RESP = "UNKNOWN.PRODUCT:" : SKU; RELEASE OF, ORDERNO; RETURN
  PRICE = PREC<2>
  VALUE1 = PRICE * QTY
  PREC<3> = PREC<3> + QTY
  WRITE PREC ON PF, SKU
  RELEASE PF, SKU
  SUBTOTAL = OREC<4> - VALUE1
  IF SUBTOTAL < 0 THEN SUBTOTAL = 0
  OREC<4> = SUBTOTAL
  OREC<5> = SUBTOTAL * 0.15
  OREC<6> = SUBTOTAL + (SUBTOTAL * 0.15)
  CUST = OREC<2>
  WRITE OREC ON OF, ORDERNO
  RELEASE OF, ORDERNO
  READU CREC FROM CF, CUST ELSE CREC = ""
  IF CREC <> "" THEN
    CREC<4> = CREC<4> - VALUE1
    IF CREC<4> < 0 THEN CREC<4> = 0
    WRITE CREC ON CF, CUST
    RELEASE CF, CUST
  END
  MID = "C*" : ORDERNO : "*" : SKU
  MREC = ""
  MREC<1> = SKU
  MREC<2> = "CREDIT"
  MREC<3> = QTY
  MREC<4> = ORDERNO
  MREC<5> = DATE()
  WRITE MREC ON MF, MID
  RESP = "OK"
  RETURN
