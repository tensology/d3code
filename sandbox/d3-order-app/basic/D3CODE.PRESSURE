* D3CODE.PRESSURE - self-resetting scenario suite. Prints CHECK <id> PASS|FAIL <detail>.
  GOSUB 100
  GOSUB 200
  GOSUB 300
  GOSUB 400
  GOSUB 500
  GOSUB 600
  GOSUB 700
  GOSUB 800
  GOSUB 900
  GOSUB 1000
  GOSUB 2100
  GOSUB 1200
  GOSUB 1300
  GOSUB 1400
  GOSUB 1500
  GOSUB 1600
  GOSUB 1700
  GOSUB 2200
  GOSUB 2300
  GOSUB 2400
  PRINT "PRESSURE DONE"
  STOP

9000 * pass
  PRINT "CHECK " : CID : " PASS " : CD
  RETURN

9100 * fail
  PRINT "CHECK " : CID : " FAIL " : CD
  RETURN

100 * boundary quantities
  CALL D3CODE.RESETX(RR)
  CALL D3CODE.SALE("C001","SKU-1",0,"B9001",RESP)
  CID = "2.1"; CD = RESP
  IF RESP = "BAD.QTY" THEN GOSUB 9000 ELSE GOSUB 9100
  CALL D3CODE.SALE("C001","SKU-1",-5,"B9001",RESP)
  CID = "2.2"; CD = RESP
  IF RESP = "BAD.QTY" THEN GOSUB 9000 ELSE GOSUB 9100
  CALL D3CODE.SALE("C001","SKU-1",1,"B9001",RESP)
  CID = "2.3"; CD = RESP
  IF RESP = "B9001*1" THEN GOSUB 9000 ELSE GOSUB 9100
  CALL D3CODE.SALE("C001","SKU-2",120,"B9002",RESP)
  CID = "2.4"; CD = RESP
  IF RESP = "B9002*1" THEN GOSUB 9000 ELSE GOSUB 9100
  CALL D3CODE.SALE("C001","SKU-2",1,"B9003",RESP)
  CID = "2.5"; CD = RESP
  IF RESP = "NO.STOCK:SKU-2" THEN GOSUB 9000 ELSE GOSUB 9100
  OPEN "D3CODE.PRODUCTS" TO PF ELSE GOSUB 9100
  READ PREC FROM PF,"SKU-2" ELSE PREC = ""
  CID = "2.6"; CD = "qoh=" : PREC<3>
  IF PREC<3> = 0 THEN GOSUB 9000 ELSE GOSUB 9100
  RETURN

200 * credit limit boundary: C004 limit 5000, SKU-4 price 210, stock 30
  CALL D3CODE.RESETX(RR)
  CALL D3CODE.SALE("C004","SKU-4",23,"B9010",RESP)
  CID = "3.1"; CD = RESP
  IF RESP = "B9010*1" THEN GOSUB 9000 ELSE GOSUB 9100
  CALL D3CODE.SALE("C004","SKU-4",1,"B9010",RESP)
  CID = "3.2"; CD = RESP
  IF RESP = "CREDIT.LIMIT:C004" THEN GOSUB 9000 ELSE GOSUB 9100
  OPEN "D3CODE.CUSTOMERS" TO CF ELSE GOSUB 9100
  READ CREC FROM CF,"C004" ELSE CREC = ""
  CID = "3.3"; CD = "bal=" : CREC<4>
  IF CREC<4> = 4830 THEN GOSUB 9000 ELSE GOSUB 9100
  RETURN

300 * lock released after a rejection
  CALL D3CODE.RESETX(RR)
  CALL D3CODE.SALE("C001","SKU-3",99,"B9020",RESP)
  CALL D3CODE.SALE("C001","SKU-3",1,"B9020",RESP)
  CID = "4.1"; CD = RESP
  IF RESP = "B9020*1" THEN GOSUB 9000 ELSE GOSUB 9100
  RETURN

400 * goods receipt
  CALL D3CODE.RESETX(RR)
  CALL D3CODE.RECEIVE("SKU-3",50,"GRN-1",RESP)
  OPEN "D3CODE.PRODUCTS" TO PF ELSE GOSUB 9100
  READ PREC FROM PF,"SKU-3" ELSE PREC = ""
  CID = "5.1"; CD = "qoh=" : PREC<3>
  IF PREC<3> = 58 THEN GOSUB 9000 ELSE GOSUB 9100
  OPEN "D3CODE.MOVES" TO MF ELSE GOSUB 9100
  READ MREC FROM MF,"R*GRN-1" ELSE MREC = ""
  CID = "5.2"; CD = "type=" : MREC<2>
  IF MREC<2> = "RECEIPT" THEN GOSUB 9000 ELSE GOSUB 9100
  RETURN

500 * settle, then settle again
  CALL D3CODE.RESETX(RR)
  CALL D3CODE.SALE("C001","SKU-1",2,"B9030",RESP)
  CALL D3CODE.SETTLE("B9030",179.9,RESP2)
  CALL D3CODE.SETTLE("B9030",179.9,RESP3)
  OPEN "D3CODE.ORDERS" TO OF ELSE GOSUB 9100
  READ OREC FROM OF,"B9030" ELSE OREC = ""
  CID = "6.1"; CD = "status=" : OREC<3>
  IF OREC<3> = "PAID" THEN GOSUB 9000 ELSE GOSUB 9100
  OPEN "D3CODE.CUSTOMERS" TO CF ELSE GOSUB 9100
  READ CREC FROM CF,"C001" ELSE CREC = ""
  CID = "6.2"; CD = "bal=" : CREC<4> : " settle=" : RESP2
  IF CREC<4> = 0 THEN GOSUB 9000 ELSE GOSUB 9100
  CID = "7.1"; CD = RESP3
  IF RESP3 = "ALREADY.PAID" THEN GOSUB 9000 ELSE GOSUB 9100
  RETURN

600 * cancel, then cancel again, then cancel a paid order
  CALL D3CODE.RESETX(RR)
  CALL D3CODE.SALE("C001","SKU-1",2,"B9040",RESP)
  CALL D3CODE.CANCEL("B9040",RESP2)
  CALL D3CODE.CANCEL("B9040",RESP3)
  OPEN "D3CODE.PRODUCTS" TO PF ELSE GOSUB 9100
  READ PREC FROM PF,"SKU-1" ELSE PREC = ""
  CID = "8.1"; CD = "qoh=" : PREC<3>
  IF PREC<3> = 40 THEN GOSUB 9000 ELSE GOSUB 9100
  OPEN "D3CODE.CUSTOMERS" TO CF ELSE GOSUB 9100
  READ CREC FROM CF,"C001" ELSE CREC = ""
  CID = "8.2"; CD = "bal=" : CREC<4>
  IF CREC<4> = 0 THEN GOSUB 9000 ELSE GOSUB 9100
  OPEN "D3CODE.ORDERS" TO OF ELSE GOSUB 9100
  READ OREC FROM OF,"B9040" ELSE OREC = ""
  CID = "8.3"; CD = "status=" : OREC<3>
  IF OREC<3> = "CANCELLED" THEN GOSUB 9000 ELSE GOSUB 9100
  CID = "9.1"; CD = RESP3
  IF RESP3 = "ALREADY.CANCELLED" THEN GOSUB 9000 ELSE GOSUB 9100
  CALL D3CODE.SALE("C001","SKU-1",1,"B9041",RESP)
  CALL D3CODE.SETTLE("B9041",89.95,RP)
  CALL D3CODE.CANCEL("B9041",RC)
  CID = "10.1"; CD = RC
  IF RC = "PAID.CANNOT.CANCEL" THEN GOSUB 9000 ELSE GOSUB 9100
  RETURN

700 * statement
  CALL D3CODE.RESETX(RR)
  CALL D3CODE.SALE("C002","SKU-4",1,"B9050",RESP)
  CALL D3CODE.SALE("C002","SKU-5",2,"B9051",RESP)
  PRINT "STATEMENT-PROBE-BEGIN"
  CALL D3CODE.STATEMENT("C002",RS)
  PRINT "STATEMENT-PROBE-END"
  CID = "11.1"; CD = RS
  IF RS = "OK" THEN GOSUB 9000 ELSE GOSUB 9100
  RETURN

800 * bulk load
  CALL D3CODE.RESETX(RR)
  FOR I = 1 TO 50
    ORD = "L" : I
    CALL D3CODE.SALE("C002","SKU-5",1,ORD,RESP)
  NEXT I
  OPEN "D3CODE.ORDERS" TO OF ELSE GOSUB 9100
  C = 0
  FOR I = 1 TO 50
    ORD = "L" : I
    READ OREC FROM OF,ORD ELSE OREC = ""
    IF OREC <> "" THEN C = C + 1
  NEXT I
  CID = "12.1"; CD = "orders=" : C
  IF C = 50 THEN GOSUB 9000 ELSE GOSUB 9100
  OPEN "D3CODE.PRODUCTS" TO PF ELSE GOSUB 9100
  READ PREC FROM PF,"SKU-5" ELSE PREC = ""
  CID = "12.2"; CD = "qoh=" : PREC<3>
  IF PREC<3> = 10 THEN GOSUB 9000 ELSE GOSUB 9100
  RETURN

900 * VAT on an exact amount
  CALL D3CODE.RESETX(RR)
  CALL D3CODE.SALE("C002","SKU-4",3,"B9060",RESP)
  OPEN "D3CODE.ORDERS" TO OF ELSE GOSUB 9100
  READ OREC FROM OF,"B9060" ELSE OREC = ""
  CID = "13.1"; CD = "sub=" : OREC<4> : " vat=" : OREC<5>
  IF OREC<4> = 630 AND OREC<5> = 94.5 THEN GOSUB 9000 ELSE GOSUB 9100
  RETURN

1000 * unknown keys
  CALL D3CODE.RESETX(RR)
  CALL D3CODE.SALE("C999","SKU-1",1,"B9100",RESP)
  CID = "14.1"; CD = RESP
  IF RESP = "UNKNOWN.CUSTOMER:C999" THEN GOSUB 9000 ELSE GOSUB 9100
  CALL D3CODE.SALE("C001","SKU-99",1,"B9100",RESP)
  CID = "14.2"; CD = RESP
  IF RESP = "UNKNOWN.PRODUCT:SKU-99" THEN GOSUB 9000 ELSE GOSUB 9100
  CALL D3CODE.SETTLE("NOPE",1,RESP)
  CID = "14.3"; CD = RESP
  IF RESP = "UNKNOWN.ORDER:NOPE" THEN GOSUB 9000 ELSE GOSUB 9100
  CALL D3CODE.CANCEL("NOPE",RESP)
  CID = "14.4"; CD = RESP
  IF RESP = "UNKNOWN.ORDER:NOPE" THEN GOSUB 9000 ELSE GOSUB 9100
  RETURN

1300 * one order with 100 lines (sequence integrity)
  CALL D3CODE.RESETX(RR)
  FOR I = 1 TO 100
    CALL D3CODE.SALE("C001","SKU-2",1,"M1",RESP)
  NEXT I
  OPEN "D3CODE.ORDERS" TO OF ELSE GOSUB 9100
  READ OREC FROM OF,"M1" ELSE OREC = ""
  CID = "17.1"; CD = "lines=" : OREC<7> : " sub=" : OREC<4>
  IF OREC<7> = 100 AND OREC<4> = 4250 THEN GOSUB 9000 ELSE GOSUB 9100
  OPEN "D3CODE.LINES" TO LF ELSE GOSUB 9100
  READ LREC FROM LF,"M1*100" ELSE LREC = ""
  CID = "17.2"; CD = "last=" : LREC<1> : "/" : LREC<2>
  IF LREC<1> = "M1" AND LREC<2> = "SKU-2" THEN GOSUB 9000 ELSE GOSUB 9100
  OPEN "D3CODE.PRODUCTS" TO PF ELSE GOSUB 9100
  READ PREC FROM PF,"SKU-2" ELSE PREC = ""
  CID = "17.3"; CD = "qoh=" : PREC<3>
  IF PREC<3> = 20 THEN GOSUB 9000 ELSE GOSUB 9100
  RETURN

1400 * zero-price product is still a valid line
  CALL D3CODE.RESETX(RR)
  OPEN "D3CODE.PRODUCTS" TO PF ELSE GOSUB 9100
  PREC = ""
  PREC<1> = "Free sample"
  PREC<2> = 0
  PREC<3> = 5
  PREC<4> = 1
  WRITE PREC ON PF,"SKU-Z"
  CALL D3CODE.SALE("C001","SKU-Z",2,"Z1",RESP)
  CID = "18.1"; CD = RESP
  IF RESP = "Z1*1" THEN GOSUB 9000 ELSE GOSUB 9100
  OPEN "D3CODE.ORDERS" TO OF ELSE GOSUB 9100
  READ OREC FROM OF,"Z1" ELSE OREC = ""
  CID = "18.2"; CD = "sub=" : OREC<4> : " vat=" : OREC<5>
  IF OREC<4> = 0 AND OREC<5> = 0 THEN GOSUB 9000 ELSE GOSUB 9100
  DELETE PF,"SKU-Z"
  RETURN

1500 * balance reconciliation: balance equals the sum of OPEN orders
  CALL D3CODE.RESETX(RR)
  CALL D3CODE.SALE("C001","SKU-1",1,"F1",RESP)
  CALL D3CODE.SALE("C001","SKU-2",1,"F2",RESP)
  CALL D3CODE.SALE("C001","SKU-3",1,"F3",RESP)
  CALL D3CODE.CANCEL("F2",RESP)
  CALL D3CODE.SETTLE("F3",65,RESP)
  OPEN "D3CODE.CUSTOMERS" TO CF ELSE GOSUB 9100
  READ CREC FROM CF,"C001" ELSE CREC = ""
  OPEN "D3CODE.ORDERS" TO OF ELSE GOSUB 9100
  N = DCOUNT(CREC<6>, @VM)
  SUM = 0
  FOR I = 1 TO N
    ORD = CREC<6, I>
    READ OREC FROM OF,ORD ELSE OREC = ""
    IF OREC <> "" THEN
      IF OREC<3> = "OPEN" THEN SUM = SUM + OREC<4>
    END
  NEXT I
  CID = "19.1"; CD = "balance=" : CREC<4> : " openSum=" : SUM
  IF CREC<4> = SUM AND SUM = 89.95 THEN GOSUB 9000 ELSE GOSUB 9100
  RETURN

1600 * stock conservation across sale, receipt and cancellation
  CALL D3CODE.RESETX(RR)
  OPEN "D3CODE.PRODUCTS" TO PF ELSE GOSUB 9100
  READ PREC FROM PF,"SKU-1" ELSE PREC = ""
  OPENING = PREC<3>
  CALL D3CODE.SALE("C001","SKU-1",5,"G1",RESP)
  CALL D3CODE.RECEIVE("SKU-1",10,"GRN-G",RESP)
  CALL D3CODE.SALE("C001","SKU-1",2,"G2",RESP)
  CALL D3CODE.CANCEL("G2",RESP)
  READ PREC FROM PF,"SKU-1" ELSE PREC = ""
  CID = "20.1"; CD = "open=" : OPENING : " now=" : PREC<3>
  IF PREC<3> = (OPENING - 5 + 10) THEN GOSUB 9000 ELSE GOSUB 9100
  RETURN

1700 * cancel after the product was deleted reports partial restoration
  CALL D3CODE.RESETX(RR)
  OPEN "D3CODE.PRODUCTS" TO PF ELSE GOSUB 9100
  CALL D3CODE.SALE("C001","SKU-1",3,"H1",RESP)
  DELETE PF,"SKU-1"
  CALL D3CODE.CANCEL("H1",RC)
  CID = "21.1"; CD = "cancel=" : RC
  IF RC = "OK.PARTIAL" THEN GOSUB 9000 ELSE GOSUB 9100
  RETURN

2200 * credit note returns stock and reduces the balance
  CALL D3CODE.RESETX(RR)
  CALL D3CODE.SALE("C001","SKU-1",5,"K1",RESP)
  CALL D3CODE.CREDIT("K1","SKU-1",2,RC)
  OPEN "D3CODE.PRODUCTS" TO PF ELSE GOSUB 9100
  READ PREC FROM PF,"SKU-1" ELSE PREC = ""
  CID = "22.1"; CD = "qoh=" : PREC<3> : " credit=" : RC
  IF PREC<3> = 37 AND RC = "OK" THEN GOSUB 9000 ELSE GOSUB 9100
  OPEN "D3CODE.ORDERS" TO OF ELSE GOSUB 9100
  READ OREC FROM OF,"K1" ELSE OREC = ""
  CID = "22.2"; CD = "sub=" : OREC<4> : " total=" : OREC<6>
  IF OREC<4> = 269.85 THEN GOSUB 9000 ELSE GOSUB 9100
  OPEN "D3CODE.CUSTOMERS" TO CF ELSE GOSUB 9100
  READ CREC FROM CF,"C001" ELSE CREC = ""
  CID = "22.3"; CD = "bal=" : CREC<4>
  IF CREC<4> = 269.85 THEN GOSUB 9000 ELSE GOSUB 9100
  RETURN

2300 * three-decimal price arithmetic
  CALL D3CODE.RESETX(RR)
  OPEN "D3CODE.PRODUCTS" TO PF ELSE GOSUB 9100
  PREC = ""
  PREC<1> = "Fractional item"
  PREC<2> = 0.125
  PREC<3> = 100
  PREC<4> = 1
  WRITE PREC ON PF,"SKU-F"
  CALL D3CODE.SALE("C001","SKU-F",8,"N1",RESP)
  OPEN "D3CODE.ORDERS" TO OF ELSE GOSUB 9100
  READ OREC FROM OF,"N1" ELSE OREC = ""
  CID = "23.1"; CD = "sub=" : OREC<4> : " vat=" : OREC<5>
  IF OREC<4> = 1 AND OREC<5> = 0.15 THEN GOSUB 9000 ELSE GOSUB 9100
  DELETE PF,"SKU-F"
  RETURN

2400 * credit note against a cancelled order is refused
  CALL D3CODE.RESETX(RR)
  CALL D3CODE.SALE("C001","SKU-1",1,"K2",RESP)
  CALL D3CODE.CANCEL("K2",RESP)
  CALL D3CODE.CREDIT("K2","SKU-1",1,RC)
  CID = "24.1"; CD = RC
  IF RC = "CANCELLED.ORDER" THEN GOSUB 9000 ELSE GOSUB 9100
  RETURN

2100 * absurd quantity
  CALL D3CODE.RESETX(RR)
  CALL D3CODE.SALE("C001","SKU-1",999999,"B9090",RESP)
  CID = "15.1"; CD = RESP
  IF RESP = "NO.STOCK:SKU-1" THEN GOSUB 9000 ELSE GOSUB 9100
  RETURN

1200 * long attribute round-trip (checked by length, not by 80-column display)
  CALL D3CODE.RESETX(RR)
  OPEN "D3CODE.PRODUCTS" TO PF ELSE GOSUB 9100
  PREC = ""
  PREC<1> = "A very long product description used to test attribute storage limits and readback fidelity across the harness boundary"
  PREC<2> = 210
  PREC<3> = 5
  PREC<4> = 1
  WRITE PREC ON PF,"SKU-9"
  READ CHK FROM PF,"SKU-9" ELSE CHK = ""
  CID = "16.1"; CD = "len=" : LEN(CHK<1>)
  IF LEN(CHK<1>) = 119 THEN GOSUB 9000 ELSE GOSUB 9100
  CID = "16.2"; CD = "attr2=" : CHK<2> : " attr3=" : CHK<3>
  IF CHK<2> = 210 AND CHK<3> = 5 THEN GOSUB 9000 ELSE GOSUB 9100
  DELETE PF,"SKU-9"
  RETURN
