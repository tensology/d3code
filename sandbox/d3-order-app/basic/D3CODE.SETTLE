SUBROUTINE D3CODE.SETTLE(ORDERNO, AMOUNT, RESP)
* Mark an order paid, reduce the customer balance and journal a PAYMENT.
  RESP = ""
  OPEN "D3CODE.ORDERS" TO OF ELSE RESP = "FILE.ORDERS"; RETURN
  OPEN "D3CODE.CUSTOMERS" TO CF ELSE RESP = "FILE.CUSTOMERS"; RETURN
  OPEN "D3CODE.PAYMENTS" TO YF ELSE RESP = "FILE.PAYMENTS"; RETURN
  READU OREC FROM OF, ORDERNO ELSE RESP = "UNKNOWN.ORDER:" : ORDERNO; RETURN
  STATUS = OREC<3>
  IF STATUS = "CANCELLED" THEN
    RESP = "CANCELLED.ORDER"
    RELEASE OF, ORDERNO
    RETURN
  END
  IF STATUS = "PAID" THEN
    RESP = "ALREADY.PAID"
    RELEASE OF, ORDERNO
    RETURN
  END
  CUST = OREC<2>
  OREC<3> = "PAID"
  WRITE OREC ON OF, ORDERNO
  RELEASE OF, ORDERNO
  READU CREC FROM CF, CUST ELSE RESP = "UNKNOWN.CUSTOMER:" : CUST; RETURN
  IF AMOUNT > CREC<4> THEN
    CREC<4> = 0
  END ELSE
    CREC<4> = CREC<4> - AMOUNT
  END
  WRITE CREC ON CF, CUST
  RELEASE CF, CUST
  PID = ORDERNO : "*P1"
  PREC = ""
  PREC<1> = ORDERNO
  PREC<2> = AMOUNT
  PREC<3> = DATE()
  PREC<4> = "PAYMENT"
  WRITE PREC ON YF, PID
  RESP = "OK"
  RETURN
