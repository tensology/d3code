SUBROUTINE D3CODE.SALE(CUST, SKU, QTY, ORDERNO, RESP)
* Post one sale line: validate customer + product + stock, lock the product to
* decrement stock, accumulate VAT at 15%, write the order header, the line and a
* stock movement, and record the order on the customer's order list.
  RESP = ""
  OPEN "D3CODE.CUSTOMERS" TO CF ELSE RESP = "FILE.CUSTOMERS"; RETURN
  OPEN "D3CODE.PRODUCTS" TO PF ELSE RESP = "FILE.PRODUCTS"; RETURN
  OPEN "D3CODE.ORDERS" TO OF ELSE RESP = "FILE.ORDERS"; RETURN
  OPEN "D3CODE.LINES" TO LF ELSE RESP = "FILE.LINES"; RETURN
  OPEN "D3CODE.MOVES" TO MF ELSE RESP = "FILE.MOVES"; RETURN
  READ CREC FROM CF, CUST ELSE RESP = "UNKNOWN.CUSTOMER:" : CUST; RETURN
  IF QTY < 1 THEN RESP = "BAD.QTY"; RETURN
  READU PREC FROM PF, SKU ELSE RESP = "UNKNOWN.PRODUCT:" : SKU; RETURN
  QOH = PREC<3>
  IF QTY > QOH THEN
    RESP = "NO.STOCK:" : SKU
    RELEASE PF, SKU
    RETURN
  END
  PRICE = PREC<2>
  LINETOT = PRICE * QTY
  LIMIT = CREC<3>
  BALANCE = CREC<4>
  IF (BALANCE + LINETOT) > LIMIT THEN
    RESP = "CREDIT.LIMIT:" : CUST
    RELEASE PF, SKU
    RETURN
  END
  PREC<3> = QOH - QTY
  WRITE PREC ON PF, SKU
  RELEASE PF, SKU
  READU OREC FROM OF, ORDERNO ELSE OREC = ""
  OREC<1> = DATE()
  OREC<2> = CUST
  OREC<3> = "OPEN"
  SUBTOTAL = OREC<4> + LINETOT
  OREC<4> = SUBTOTAL
  OREC<5> = SUBTOTAL * 0.15
  OREC<6> = SUBTOTAL + (SUBTOTAL * 0.15)
  SEQ = OREC<7> + 1
  OREC<7> = SEQ
  WRITE OREC ON OF, ORDERNO
  RELEASE OF, ORDERNO
  N = DCOUNT(CREC<6>, @VM)
  CREC<6, N + 1> = ORDERNO
  CREC<4> = BALANCE + LINETOT
  WRITE CREC ON CF, CUST
  LID = ORDERNO : "*" : SEQ
  LREC = ""
  LREC<1> = ORDERNO
  LREC<2> = SKU
  LREC<3> = QTY
  LREC<4> = PRICE
  LREC<5> = LINETOT
  WRITE LREC ON LF, LID
  MID = ORDERNO : "*" : SEQ
  MREC = ""
  MREC<1> = SKU
  MREC<2> = "SALE"
  MREC<3> = QTY
  MREC<4> = ORDERNO
  MREC<5> = DATE()
  WRITE MREC ON MF, MID
  RESP = LID
  RETURN
