* D3CODE.RUN - drive the sandbox end to end: post real orders, then exercise
* every validation path (stock, unknown product, unknown customer, credit).
  PRINT "== ORDER B2001 (Highveld Hardware) =="
  CALL D3CODE.SALE("C001", "SKU-1", 3, "B2001", RESP)
  PRINT "  L1 " : RESP
  CALL D3CODE.SALE("C001", "SKU-2", 10, "B2001", RESP)
  PRINT "  L2 " : RESP

  PRINT "== ORDER B2002 (Cape Coffee Co) =="
  CALL D3CODE.SALE("C002", "SKU-4", 5, "B2002", RESP)
  PRINT "  L1 " : RESP
  CALL D3CODE.SALE("C002", "SKU-5", 12, "B2002", RESP)
  PRINT "  L2 " : RESP

  PRINT "== ORDER B2003 (Durban Drapers) =="
  CALL D3CODE.SALE("C003", "SKU-3", 2, "B2003", RESP)
  PRINT "  L1 " : RESP

  PRINT "== VALIDATION PATHS =="
  CALL D3CODE.SALE("C001", "SKU-3", 99, "B2001", RESP)
  PRINT "  over-stock     -> " : RESP
  CALL D3CODE.SALE("C001", "SKU-9", 1, "B2001", RESP)
  PRINT "  unknown product-> " : RESP
  CALL D3CODE.SALE("C099", "SKU-1", 1, "B2001", RESP)
  PRINT "  unknown customer-> " : RESP
  CALL D3CODE.SALE("C004", "SKU-4", 25, "B2004", RESP)
  PRINT "  credit limit   -> " : RESP
  PRINT "RUN DONE"
  STOP
